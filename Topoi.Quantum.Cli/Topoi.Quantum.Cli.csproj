<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <RootNamespace>Topoi.Quantum.Cli</RootNamespace>
    <AssemblyName>Topoi.Quantum.Cli</AssemblyName>

    <IsPackable>true</IsPackable>

    <PackageId>Topoi.Quantum.Cli</PackageId>
    <Title>Topoi Quantum CLI Components</Title>

    <Description>
      Command parsing, interactive execution and console support
      used by the Topoi Quantum command-line tool.
    </Description>

    <PackageTags>
      quantum;cli;console;tool;dotnet;csharp
    </PackageTags>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Topoi.Quantum\Topoi.Quantum.csproj" />
    <ProjectReference Include="..\Topoi.Quantum.Drawing\Topoi.Quantum.Drawing.csproj" />
    <ProjectReference Include="..\Topoi.Quantum.OpenQasm\Topoi.Quantum.OpenQasm.csproj" />
    <ProjectReference Include="..\Topoi.Quantum.Parsing\Topoi.Quantum.Parsing.csproj" />
  </ItemGroup>
</Project>