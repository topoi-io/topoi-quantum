<Project>
  <PropertyGroup>
    <!-- Shared release version for every Topoi Quantum package -->
    <VersionPrefix>0.1.0</VersionPrefix>

    <!-- Shared package metadata -->
    <Authors>Topoi</Authors>
    <Company>Topoi</Company>
    <Copyright>Copyright © Topoi 2026</Copyright>

    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageIcon>topoi-icon.svg</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <RepositoryUrl>https://github.com/topoi-io/topoi-quantum</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://topoi-io.github.io/quantum/</PackageProjectUrl>

    <PackageReleaseNotes>
      Initial public MVP release of Topoi Quantum.
      Includes dense state-vector simulation, circuit construction,
      sampling, Pauli expectation estimation, OpenQASM support,
      circuit drawing, parsing, CLI components and the tq .NET tool.
    </PackageReleaseNotes>

    <PublishRepositoryUrl>true</PublishRepositoryUrl>

    <!-- Produce .snupkg symbol packages -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <!-- Improve package traceability when built by GitHub Actions -->
    <ContinuousIntegrationBuild
      Condition="'$(GITHUB_ACTIONS)' == 'true'">
      true
    </ContinuousIntegrationBuild>
  </PropertyGroup>
  <ItemGroup>
  <None Include="$(MSBuildThisFileDirectory)README.md"
        Pack="true"
        PackagePath="\" />
  <None Include="$(MSBuildThisFileDirectory)assets\topoi-icon.svg"
        Pack="true"
        PackagePath="\" />
   </ItemGroup>
</Project>