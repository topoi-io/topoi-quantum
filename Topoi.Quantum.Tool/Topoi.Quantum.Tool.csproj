<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <RootNamespace>Topoi.Quantum.Tool</RootNamespace>
    <AssemblyName>Topoi.Quantum.Tool</AssemblyName>

    <PackAsTool>true</PackAsTool>
    <ToolCommandName>tq</ToolCommandName>

    <PackageId>Topoi.Quantum.Tool</PackageId>
    <Title>Topoi Quantum Tool</Title>

    <Description>
      Command-line tool for Topoi Quantum, providing local
      state-vector simulation, OpenQASM execution, sampling,
      expectation values and circuit inspection.
    </Description>

    <PackageTags>
      quantum;openqasm;qasm;simulator;cli;tool;dotnet
    </PackageTags>

    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Topoi.Quantum.Cli\Topoi.Quantum.Cli.csproj" />
    <ProjectReference Include="..\Topoi.Quantum\Topoi.Quantum.csproj" />
    <ProjectReference Include="..\Topoi.Quantum.Drawing\Topoi.Quantum.Drawing.csproj" />
    <ProjectReference Include="..\Topoi.Quantum.OpenQasm\Topoi.Quantum.OpenQasm.csproj" />
    <ProjectReference Include="..\Topoi.Quantum.Parsing\Topoi.Quantum.Parsing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md"
          Pack="true"
          PackagePath="\" />
  </ItemGroup>
</Project>